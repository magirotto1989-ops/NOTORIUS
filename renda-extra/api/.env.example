NODE_ENV=development
PORT=3333
DATABASE_URL=postgresql://renda:renda@localhost:5432/rendamais?schema=public
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-48-bytes-ou-mais
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=*
USD_BRL_FALLBACK=5.40
# E-mails que viram ADMIN ao se cadastrar (separados por vírgula)
ADMIN_EMAILS=
# Valor do header Authorization configurado no webhook do RevenueCat
REVENUECAT_WEBHOOK_AUTH=
# Somente dev/QA: libera POST /billing/dev-activate
ALLOW_DEV_BILLING=true
